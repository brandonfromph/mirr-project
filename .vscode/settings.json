{
  "files.eol": "\n",
  "python.testing.unittestArgs": [
    "-v",
    "-s",
    "./tests",
    "-p",
    "*test.py"
  ],
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": true,
  "files.associations": {
    "*.mirr": "mirr"
  },
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "keyword.declaration.module.mirr, keyword.control.mirr",
        "settings": {
          "foreground": "#00E5FF",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "keyword.other.signal.mirr, keyword.other.direction.mirr",
        "settings": {
          "foreground": "#00E5FF"
        }
      },
      {
        "scope": "keyword.declaration.guard.mirr",
        "settings": {
          "foreground": "#22C55E",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "entity.name.function.guard.mirr",
        "settings": {
          "foreground": "#22C55E"
        }
      },
      {
        "scope": "keyword.declaration.reflex.mirr",
        "settings": {
          "foreground": "#c084fc",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "entity.name.function.reflex.mirr",
        "settings": {
          "foreground": "#c084fc"
        }
      },
      {
        "scope": "keyword.declaration.property.mirr, keyword.declaration.pattern.mirr",
        "settings": {
          "foreground": "#f59e0b",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "entity.name.function.property.mirr, entity.name.function.pattern.mirr",
        "settings": {
          "foreground": "#fbbf24"
        }
      },
      {
        "scope": "keyword.control.temporal.mirr",
        "settings": {
          "foreground": "#22C55E"
        }
      },
      {
        "scope": "keyword.control.property.mirr",
        "settings": {
          "foreground": "#c084fc",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "storage.modifier.mirr",
        "settings": {
          "foreground": "#f59e0b"
        }
      },
      {
        "scope": "storage.type.primitive.mirr, storage.type.unsigned.mirr, storage.type.signed.mirr",
        "settings": {
          "foreground": "#34d399"
        }
      },
      {
        "scope": "entity.name.type.module.mirr",
        "settings": {
          "foreground": "#fbbf24",
          "fontStyle": "bold"
        }
      },
      {
        "scope": "entity.name.function.call.mirr",
        "settings": {
          "foreground": "#34d399"
        }
      },
      {
        "scope": "constant.language.boolean.mirr, constant.numeric.decimal.mirr",
        "settings": {
          "foreground": "#f59e0b"
        }
      },
      {
        "scope": "variable.annotation.clock-domain.mirr",
        "settings": {
          "foreground": "#c084fc",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "entity.name.tag.phantom.mirr",
        "settings": {
          "foreground": "#fb7185"
        }
      },
      {
        "scope": "comment.line.double-slash.mirr",
        "settings": {
          "foreground": "#6b7280",
          "fontStyle": "italic"
        }
      },
      {
        "scope": "keyword.operator.implication.mirr",
        "settings": {
          "foreground": "#00E5FF"
        }
      },
      {
        "scope": "variable.parameter.template.mirr",
        "settings": {
          "foreground": "#fb7185"
        }
      }
    ]
  },
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex x2",
      "tools": [
        "pdflatex",
        "pdflatex"
      ]
    }
  ],
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "C:\\Users\\elvie\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\pdflatex.exe",
      "args": [
        "-interaction=nonstopmode",
        "-synctex=1",
        "%DOC%"
      ],
      "env": {}
    }
  ],
  "latex-workshop.latex.rootFile": "${workspaceFolder}/paper/living-doc/main.tex",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.chktex.path": "C:\\Users\\elvie\\AppData\\Local\\Programs\\MiKTeX\\miktex\\bin\\x64\\chktex.exe",
  "latex-workshop.chktex.enabled": true,
  "latex-workshop.linting.chktex.enabled": true,
  "latex-workshop.message.error.show": false,
  "latex-workshop.message.warning.show": false,
  "latex-workshop.message.information.show": false,
  "latex-workshop.message.badbox.show": false,
  "python-envs.defaultEnvManager": "ms-python.python:system",
  "github.copilot-chat.enable": true,
  "github.copilot-chat.useLocalTooling": true,
  "github.copilot-chat.customAgents": [".agent.md"],
  "github.copilot-chat.agentSelection": "custom",
  "github.copilot-chat.autoSuggest": true,
  "github.copilot-chat.enableAnswers": true,
  "github.copilot-chat.experimentalFeatures": {
    "kbIntegration": true,
    "scopedKnowledge": true
  }
}
