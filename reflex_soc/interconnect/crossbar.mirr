// Non-blocking Crossbar Interconnect
// Routes data from 16 inputs to 16 outputs
def crossbar(
    clk: signal in bool,
    addr_0: signal in u16,
    data_in_0: signal in u64,
    data_out_0: signal out u64,
    addr_1: signal in u16,
    data_in_1: signal in u64,
    data_out_1: signal out u64,
    addr_2: signal in u16,
    data_in_2: signal in u64,
    data_out_2: signal out u64,
    addr_3: signal in u16,
    data_in_3: signal in u64,
    data_out_3: signal out u64,
    addr_4: signal in u16,
    data_in_4: signal in u64,
    data_out_4: signal out u64,
    addr_5: signal in u16,
    data_in_5: signal in u64,
    data_out_5: signal out u64,
    addr_6: signal in u16,
    data_in_6: signal in u64,
    data_out_6: signal out u64,
    addr_7: signal in u16,
    data_in_7: signal in u64,
    data_out_7: signal out u64,
    addr_8: signal in u16,
    data_in_8: signal in u64,
    data_out_8: signal out u64,
    addr_9: signal in u16,
    data_in_9: signal in u64,
    data_out_9: signal out u64,
    addr_10: signal in u16,
    data_in_10: signal in u64,
    data_out_10: signal out u64,
    addr_11: signal in u16,
    data_in_11: signal in u64,
    data_out_11: signal out u64,
    addr_12: signal in u16,
    data_in_12: signal in u64,
    data_out_12: signal out u64,
    addr_13: signal in u16,
    data_in_13: signal in u64,
    data_out_13: signal out u64,
    addr_14: signal in u16,
    data_in_14: signal in u64,
    data_out_14: signal out u64,
    addr_15: signal in u16,
    data_in_15: signal in u64,
    data_out_15: signal out u64
) {
    reflect {
        guard always_on {
            when clk
            for 1 cycles;
        }

        reflex route {
            on always_on {
                data_out_0 = data_in_0;
                data_out_1 = data_in_1;
                data_out_2 = data_in_2;
                data_out_3 = data_in_3;
                data_out_4 = data_in_4;
                data_out_5 = data_in_5;
                data_out_6 = data_in_6;
                data_out_7 = data_in_7;
                data_out_8 = data_in_8;
                data_out_9 = data_in_9;
                data_out_10 = data_in_10;
                data_out_11 = data_in_11;
                data_out_12 = data_in_12;
                data_out_13 = data_in_13;
                data_out_14 = data_in_14;
                data_out_15 = data_in_15;
            }
        }
    }
}

module crossbar {}