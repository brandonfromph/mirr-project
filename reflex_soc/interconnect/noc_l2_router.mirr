//! Auto-generated L2 Global NoC Interconnect Router
pattern noc_l2_router(
    clk: signal in bool,
    rst_n: signal in bool,
    uplink_valid_0: signal in bool,
    uplink_data_0: signal in u64,
    uplink_valid_1: signal in bool,
    uplink_data_1: signal in u64,
    uplink_valid_2: signal in bool,
    uplink_data_2: signal in u64,
    uplink_valid_3: signal in bool,
    uplink_data_3: signal in u64,
    downlink_valid_0: signal out bool,
    downlink_data_0: signal out u64,
    downlink_valid_1: signal out bool,
    downlink_data_1: signal out u64,
    downlink_valid_2: signal out bool,
    downlink_data_2: signal out u64,
    downlink_valid_3: signal out bool,
    downlink_data_3: signal out u64
) {
    signal buf_valid_0: internal bool;
    signal buf_data_0: internal u64;
    signal is_reflex_0: internal bool;
    signal is_normal_0: internal bool;
    signal req_valid_0: internal bool;
    signal req_data_0: internal u64;
    signal buf_valid_1: internal bool;
    signal buf_data_1: internal u64;
    signal is_reflex_1: internal bool;
    signal is_normal_1: internal bool;
    signal req_valid_1: internal bool;
    signal req_data_1: internal u64;
    signal buf_valid_2: internal bool;
    signal buf_data_2: internal u64;
    signal is_reflex_2: internal bool;
    signal is_normal_2: internal bool;
    signal req_valid_2: internal bool;
    signal req_data_2: internal u64;
    signal buf_valid_3: internal bool;
    signal buf_data_3: internal u64;
    signal is_reflex_3: internal bool;
    signal is_normal_3: internal bool;
    signal req_valid_3: internal bool;
    signal req_data_3: internal u64;
    signal w_r_0: internal bool;
    signal w_n_0: internal bool;
    signal w_r_1: internal bool;
    signal w_n_1: internal bool;
    signal w_r_2: internal bool;
    signal w_n_2: internal bool;
    signal w_r_3: internal bool;
    signal w_n_3: internal bool;

    signal any_r: internal bool;
    signal any_w: internal bool;
    
    reflex req_eval {
        on always {
            is_reflex_0 = uplink_valid_0 && ((uplink_data_0 >> 62) == 1);
            is_normal_0 = uplink_valid_0 && !is_reflex_0;
            req_valid_0 = is_reflex_0 || is_normal_0 || buf_valid_0;
            // We prioritize the incoming packet over the buffer for processing if both exist
            is_reflex_1 = uplink_valid_1 && ((uplink_data_1 >> 62) == 1);
            is_normal_1 = uplink_valid_1 && !is_reflex_1;
            req_valid_1 = is_reflex_1 || is_normal_1 || buf_valid_1;
            // We prioritize the incoming packet over the buffer for processing if both exist
            is_reflex_2 = uplink_valid_2 && ((uplink_data_2 >> 62) == 1);
            is_normal_2 = uplink_valid_2 && !is_reflex_2;
            req_valid_2 = is_reflex_2 || is_normal_2 || buf_valid_2;
            // We prioritize the incoming packet over the buffer for processing if both exist
            is_reflex_3 = uplink_valid_3 && ((uplink_data_3 >> 62) == 1);
            is_normal_3 = uplink_valid_3 && !is_reflex_3;
            req_valid_3 = is_reflex_3 || is_normal_3 || buf_valid_3;
            // We prioritize the incoming packet over the buffer for processing if both exist
        }
    }

    reflex win_eval {
        on always {
            w_r_0 = is_reflex_0;
            w_r_1 = is_reflex_1 && !w_r_0;
            w_r_2 = is_reflex_2 && !w_r_0 && !w_r_1;
            w_r_3 = is_reflex_3 && !w_r_0 && !w_r_1 && !w_r_2;
            any_r = w_r_0 || w_r_1 || w_r_2 || w_r_3;
            w_n_0 = (is_normal_0 || buf_valid_0) && !any_r;
            w_n_1 = (is_normal_1 || buf_valid_1) && !any_r && !w_n_0;
            w_n_2 = (is_normal_2 || buf_valid_2) && !any_r && !w_n_0 && !w_n_1;
            w_n_3 = (is_normal_3 || buf_valid_3) && !any_r && !w_n_0 && !w_n_1 && !w_n_2;
        }
    }

    signal win_valid: internal bool;
    signal win_data: internal u64;
    signal win_dest: internal u64;

    guard g_win_r_0 { when (w_r_0) for 1 cycles; }
    reflex do_win_r_0 { on g_win_r_0 { win_valid = true; win_data = uplink_data_0; } }
    guard g_win_n_0_up { when (w_n_0 && is_normal_0) for 1 cycles; }
    reflex do_win_n_0_up { on g_win_n_0_up { win_valid = true; win_data = uplink_data_0; } }
    guard g_win_n_0_buf { when (w_n_0 && !is_normal_0 && buf_valid_0) for 1 cycles; }
    reflex do_win_n_0_buf { on g_win_n_0_buf { win_valid = true; win_data = buf_data_0; } }
    guard g_buf_store_0 { when (is_normal_0 && !w_n_0) for 1 cycles; }
    reflex do_buf_store_0 { on g_buf_store_0 { buf_valid_0 = true; buf_data_0 = uplink_data_0; } }
    guard g_buf_clear_0 { when (w_n_0 && !is_normal_0) for 1 cycles; }
    reflex do_buf_clear_0 { on g_buf_clear_0 { buf_valid_0 = false; buf_data_0 = 0; } }
    guard g_buf_keep_0 { when (!is_normal_0 && !w_n_0) for 1 cycles; }
    reflex do_buf_keep_0 { on g_buf_keep_0 { buf_valid_0 = buf_valid_0; buf_data_0 = buf_data_0; } }
    guard g_win_r_1 { when (w_r_1) for 1 cycles; }
    reflex do_win_r_1 { on g_win_r_1 { win_valid = true; win_data = uplink_data_1; } }
    guard g_win_n_1_up { when (w_n_1 && is_normal_1) for 1 cycles; }
    reflex do_win_n_1_up { on g_win_n_1_up { win_valid = true; win_data = uplink_data_1; } }
    guard g_win_n_1_buf { when (w_n_1 && !is_normal_1 && buf_valid_1) for 1 cycles; }
    reflex do_win_n_1_buf { on g_win_n_1_buf { win_valid = true; win_data = buf_data_1; } }
    guard g_buf_store_1 { when (is_normal_1 && !w_n_1) for 1 cycles; }
    reflex do_buf_store_1 { on g_buf_store_1 { buf_valid_1 = true; buf_data_1 = uplink_data_1; } }
    guard g_buf_clear_1 { when (w_n_1 && !is_normal_1) for 1 cycles; }
    reflex do_buf_clear_1 { on g_buf_clear_1 { buf_valid_1 = false; buf_data_1 = 0; } }
    guard g_buf_keep_1 { when (!is_normal_1 && !w_n_1) for 1 cycles; }
    reflex do_buf_keep_1 { on g_buf_keep_1 { buf_valid_1 = buf_valid_1; buf_data_1 = buf_data_1; } }
    guard g_win_r_2 { when (w_r_2) for 1 cycles; }
    reflex do_win_r_2 { on g_win_r_2 { win_valid = true; win_data = uplink_data_2; } }
    guard g_win_n_2_up { when (w_n_2 && is_normal_2) for 1 cycles; }
    reflex do_win_n_2_up { on g_win_n_2_up { win_valid = true; win_data = uplink_data_2; } }
    guard g_win_n_2_buf { when (w_n_2 && !is_normal_2 && buf_valid_2) for 1 cycles; }
    reflex do_win_n_2_buf { on g_win_n_2_buf { win_valid = true; win_data = buf_data_2; } }
    guard g_buf_store_2 { when (is_normal_2 && !w_n_2) for 1 cycles; }
    reflex do_buf_store_2 { on g_buf_store_2 { buf_valid_2 = true; buf_data_2 = uplink_data_2; } }
    guard g_buf_clear_2 { when (w_n_2 && !is_normal_2) for 1 cycles; }
    reflex do_buf_clear_2 { on g_buf_clear_2 { buf_valid_2 = false; buf_data_2 = 0; } }
    guard g_buf_keep_2 { when (!is_normal_2 && !w_n_2) for 1 cycles; }
    reflex do_buf_keep_2 { on g_buf_keep_2 { buf_valid_2 = buf_valid_2; buf_data_2 = buf_data_2; } }
    guard g_win_r_3 { when (w_r_3) for 1 cycles; }
    reflex do_win_r_3 { on g_win_r_3 { win_valid = true; win_data = uplink_data_3; } }
    guard g_win_n_3_up { when (w_n_3 && is_normal_3) for 1 cycles; }
    reflex do_win_n_3_up { on g_win_n_3_up { win_valid = true; win_data = uplink_data_3; } }
    guard g_win_n_3_buf { when (w_n_3 && !is_normal_3 && buf_valid_3) for 1 cycles; }
    reflex do_win_n_3_buf { on g_win_n_3_buf { win_valid = true; win_data = buf_data_3; } }
    guard g_buf_store_3 { when (is_normal_3 && !w_n_3) for 1 cycles; }
    reflex do_buf_store_3 { on g_buf_store_3 { buf_valid_3 = true; buf_data_3 = uplink_data_3; } }
    guard g_buf_clear_3 { when (w_n_3 && !is_normal_3) for 1 cycles; }
    reflex do_buf_clear_3 { on g_buf_clear_3 { buf_valid_3 = false; buf_data_3 = 0; } }
    guard g_buf_keep_3 { when (!is_normal_3 && !w_n_3) for 1 cycles; }
    reflex do_buf_keep_3 { on g_buf_keep_3 { buf_valid_3 = buf_valid_3; buf_data_3 = buf_data_3; } }

    guard g_no_win { when (!w_r_0 && !w_r_1 && !w_r_2 && !w_r_3 && !w_n_0 && !w_n_1 && !w_n_2 && !w_n_3) for 1 cycles; }
    reflex do_no_win { on g_no_win { win_valid = false; win_data = 0; } }

    reflex extract_dest {
        on always {
            win_dest = (win_data >> 48) & 4095;
        }
    }

    reflex route_defaults {
        on always {
            downlink_valid_0 = false;
            downlink_data_0 = 0;
            downlink_valid_1 = false;
            downlink_data_1 = 0;
            downlink_valid_2 = false;
            downlink_data_2 = 0;
            downlink_valid_3 = false;
            downlink_data_3 = 0;
        }
    }
    guard p_out_0 {
        when (win_valid && (win_dest >= 0) && (win_dest < 16)) for 1 cycles;
    }
    reflex do_out_0 { on p_out_0 { downlink_valid_0 = win_valid; downlink_data_0 = win_data; } }
    guard p_out_1 {
        when (win_valid && (win_dest >= 16) && (win_dest < 32)) for 1 cycles;
    }
    reflex do_out_1 { on p_out_1 { downlink_valid_1 = win_valid; downlink_data_1 = win_data; } }
    guard p_out_2 {
        when (win_valid && (win_dest >= 32) && (win_dest < 48)) for 1 cycles;
    }
    reflex do_out_2 { on p_out_2 { downlink_valid_2 = win_valid; downlink_data_2 = win_data; } }
    guard p_out_3 {
        when (win_valid && (win_dest >= 48) && (win_dest < 64)) for 1 cycles;
    }
    reflex do_out_3 { on p_out_3 { downlink_valid_3 = win_valid; downlink_data_3 = win_data; } }
}

module noc_l2_router {}
