    // Bounce packets for dead local cores back to L2
    signal bounce_valid: internal bool;
    signal bounce_data: internal u64;

    // Check if any local core is dead and is the destination
    signal should_bounce: internal bool;
    reflex eval_bounce_cond {
        on always {
            should_bounce = false;
            should_bounce = should_bounce || (dest_id == 0 && core_dead_0);
            should_bounce = should_bounce || (dest_id == 1 && core_dead_1);
            should_bounce = should_bounce || (dest_id == 2 && core_dead_2);
            should_bounce = should_bounce || (dest_id == 3 && core_dead_3);
            should_bounce = should_bounce || (dest_id == 4 && core_dead_4);
