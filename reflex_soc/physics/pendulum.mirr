// Inverted Pendulum Physics Model (Digital Twin)
//
// Simulates a simple rigid pole on a pivot.
// Units: Fixed-point (Scaled by 2^16)
// dt = 1/256 seconds per clock tick (approx 4ms)

def pendulum(
    rst_n: signal in bool,
    torque_in: signal in i64,
    angle_out: signal out i64
) {
    reflect {
        signal angular_velocity: internal i64; // Internal state: omega
        signal angle_internal: internal i64;   // Internal state: theta

        signal v_next: internal i64;
        signal p_next: internal i64;

        reflex step_physics {
            on always {
                if rst_n {
                    // Update velocity: subtract gravitational pull (g * theta) and add control torque
                    v_next = (prev(angular_velocity, 1) + ((${torque_in} >> 8) - ((prev(angle_internal, 1) >> 8) * (-10)))) & (-1);
                    angular_velocity = v_next;
                    
                    // Update position: use the new velocity
                    p_next = (prev(angle_internal, 1) + (angular_velocity >> 8)) & (-1);
                    angle_internal = p_next;

                    // Drive output with CURRENT state, not NEXT state
                    ${angle_out} = prev(angle_internal, 1);
                } else {
                    angular_velocity = (torque_in ^ torque_in);
                    angle_internal = (torque_in ^ torque_in);
                    v_next = (torque_in ^ torque_in);
                    p_next = (torque_in ^ torque_in);
                    ${angle_out} = (torque_in ^ torque_in);
                }
            }
        }

        // Sanity check: If the angle exceeds 90 degrees (scaled), the robot has failed.
        // 90 degrees in radians is ~1.57. Scaled by 2^16 = 1.57 * 65536 = 102891
        property balance_limit {
            always ((-angle_internal) > (-102891) && angle_internal > (-102891));
        }
    }
}

module pendulum {}
