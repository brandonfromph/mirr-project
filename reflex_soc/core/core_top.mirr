//! Phase 8b: R-SPU Core Top-Level Wrapper
//!
//! Encapsulates the 5-stage pipeline and integrates it with
//! the NoC interface and the Exception Controller.

import "pipeline.mirr" as pipe;
import "types.mirr" as types;

def core_top(
    clk: signal in bool,
    rst_n: signal in bool,
    
    // Physical I/O Interface
    io_in_0:  signal in u64,
    io_out_0: signal out u64,
    
    // Instruction Memory Interface (Internal 1-word Cache)
    pc_out:   signal out u32,
    data_out: signal out u64,
    
    // NoC Packet Interface
    noc_rx_valid: signal in bool,
    noc_rx_data:  signal in u64,
    noc_tx_valid: signal out bool,
    noc_tx_data:  signal out u64
) {
    reflect {
        // --- 1. 5-Stage Pipeline Instance ---
        signal trap_signal: internal bool;
        
        // Dynamic Instruction Latch (1-word I-Cache)
        signal current_instr: internal u64;
        
        // --- 0. Dark Silicon Wakeup Logic ---
        signal wake_timer: internal u3;
        signal core_awake: internal bool;
        signal gated_clk: internal bool;
        
        guard rx_only { when (${noc_rx_valid}) for 1 cycles; }
        guard dec_only { when (!${noc_rx_valid} && wake_timer > 0) for 1 cycles; }

        reflex handle_rx {
            on rx_only {
                wake_timer = 5;
                current_instr = ${noc_rx_data};
            }
        }

        reflex handle_dec {
            on dec_only {
                wake_timer = wake_timer - 1;
            }
        }

        reflex eval_awake {
            on always {
                core_awake = (wake_timer > 0) || ${noc_rx_valid};
                gated_clk = ${clk} && core_awake;
            }
        }

        pipe::rspu_pipeline(gated_clk, ${rst_n}, current_instr, ${io_in_0}, ${io_out_0}, ${pc_out}, ${data_out}, trap_signal);

        // --- 2. Exception Controller Logic ---
        // trap_active fires when the pipeline asserts a trap.
        // idle_tx fires every cycle to set the default (no-exception) outputs.
        // On a trap cycle, exception_tx overrides the idle_tx assignments.
        signal core_halted: internal bool;

        guard trap_active {
            when trap_signal
            for 1 cycles;
        }

        reflex idle_tx {
            on always {
                core_halted = false;
                ${noc_tx_valid} = false;
                ${noc_tx_data} = 0;
            }
        }

        reflex exception_tx {
            on trap_active {
                core_halted = true;
                ${noc_tx_valid} = true;
                ${noc_tx_data} = (1 << 63) | (14 << 32) | ${pc_out};
            }
        }
    }
}

module core_top {}
