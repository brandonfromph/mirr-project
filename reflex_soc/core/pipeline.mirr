//! Phase 8a: R-SPU 2.0 5-Stage Pipeline
//!
//! Wires together the IF, ID, EX, MEM, and WB stages with
//! integrated PCC verification and hardware type dispatch.
//! Upgraded to 64-bit instructions and 1024 registers.

import "types.mirr" as types;
import "alu.mirr" as alu;
import "regfile.mirr" as reg;
import "ram.mirr" as ram;
import "../verification/pcc_verifier.mirr" as pcc;

def rspu_pipeline(
    clk: signal in bool,
    rst_n: signal in bool,
    instr_in: signal in u64,
    io_in_0: signal in u64,
    io_out_0: signal out u64,
    pc_out: signal out u32,
    data_out: signal out u64,
    trap_out: signal out bool
) {
    reflect {
        // --- Pipeline Registers ---
        signal if_id_pc: internal u32;
        signal if_id_instr: internal u64;

        signal id_ex_pc: internal u32;
        signal id_ex_rs1: internal u64;
        signal id_ex_rs2: internal u64;
        signal id_ex_rd: internal u64;
        signal id_ex_val1: internal u64;
        signal id_ex_val2: internal u64;
        signal id_ex_op: internal u64;

        signal ex_mem_rd: internal u64;
        signal ex_mem_res: internal u64;
        signal ex_mem_op: internal u64;

        signal mem_wb_rd: internal u64;
        signal mem_wb_res: internal u64;
        signal mem_wb_we: internal bool;

        // --- 1. Fetch Stage (IF) ---
        signal pipe_pc: internal u32;
        
        // PCC Verifier Integration
        signal pcc_valid: internal bool;
        signal pcc_fault: internal bool;

        signal cert_i: internal u16;
        signal cert_r: internal u16;
        signal cert_g: internal u16;

        reflex init_cert {
            on always {
                cert_i = 0;
                cert_r = 0;
                cert_g = 0;
            }
        }

        pcc::pcc_verifier(${clk}, ${rst_n}, 
            cert_i, cert_r, cert_g, true, true,
            pcc_valid, pcc_fault
        );

        guard fetch_active(pcc_valid) for 1 cycles;
        guard fetch_fault(pcc_fault) for 1 cycles;

        reflex fetch_normal {
            on fetch_active {
                pipe_pc = (pipe_pc + 1) & 4294967295;
                ${pc_out} = pipe_pc;
                
                // Advance IF/ID
                if_id_pc = pipe_pc;
                if_id_instr = ${instr_in};
            }
        }

        reflex fetch_on_fault {
            on always {
                ${trap_out} = pcc_fault || ex_trap;
            }
        }

        // --- 2. Decode Stage (ID) ---
        signal id_val1: internal u64;
        signal id_val2: internal u64;
        
        signal dec_rs1: internal u64;
        signal dec_rs2: internal u64;
        signal dec_rd: internal u64;
        signal dec_op: internal u64;

        reflex do_decode {
            on fetch_active {
                dec_rs1 = (if_id_instr >> 48) & 1023;
                dec_rs2 = (if_id_instr >> 32) & 1023;
                dec_rd  = (if_id_instr >> 16) & 1023;
                dec_op  = (if_id_instr & 255);

                // Advance ID/EX
                id_ex_pc = if_id_pc;
                id_ex_rs1 = dec_rs1;
                id_ex_rs2 = dec_rs2;
                id_ex_rd = dec_rd;
                id_ex_val1 = id_val1;
                id_ex_val2 = id_val2;
                id_ex_op = dec_op;
            }
        }

        // regfile ports are now u10
        reg::regfile(${clk}, dec_rs1, dec_rs2, mem_wb_rd, mem_wb_we, mem_wb_res, id_val1, id_val2);

        // --- 3. Execute Stage (EX) ---
        signal ex_d1: internal u64;
        signal ex_t1: internal u64;
        signal ex_p1: internal u64;
        signal ex_d2: internal u64;
        signal ex_t2: internal u64;
        signal ex_p2: internal u64;
        
        signal ex_out_d: internal u64;
        signal ex_out_t: internal u64;
        signal ex_out_p: internal u64;
        signal ex_trap:  internal bool;
        
        types::extract_data(id_ex_val1, ex_d1);
        types::extract_tag(id_ex_val1, ex_t1);
        types::extract_provenance(id_ex_val1, ex_p1);

        types::extract_data(id_ex_val2, ex_d2);
        types::extract_tag(id_ex_val2, ex_t2);
        types::extract_provenance(id_ex_val2, ex_p2);

        alu::alu_core(${clk}, id_ex_op, 
            ex_d1, ex_t1, ex_p1,
            ex_d2, ex_t2, ex_p2,
            ex_out_d, ex_out_t, ex_out_p, ex_trap
        );

        signal ex_packed: internal u64;

        let is_load_in: bool = (id_ex_op == 0);
        let is_store_out: bool = (id_ex_op == 1);
        let is_normal_ex: bool = (id_ex_op != 0);

        guard is_store_out_g { when is_store_out for 1 cycles; }

        reflex do_ex_packed {
            on always {
                if (is_load_in) {
                    ex_packed = (1 << 32) | (${io_in_0} & 4294967295);
                } else {
                    ex_packed = ((ex_out_p & 15) << 36) | ((ex_out_t & 15) << 32) | (ex_out_d & 4294967295);
                }
            }
        }

        reflex do_store_out {
            on is_store_out_g {
                ${io_out_0} = id_ex_val1;
            }
        }

        reflex do_execute {
            on fetch_active {
                // Advance EX/MEM
                ex_mem_rd = id_ex_rd;
                ex_mem_res = ex_packed;
                ex_mem_op = id_ex_op;
            }
        }

        // --- 4. Memory Stage (MEM) ---
        signal mem_out: internal u64;
        signal ram_addr: internal u32;
        
        let is_load: bool = (ex_mem_op == 6);

        reflex advance_mem_wb_res {
            on always {
                if (is_load) {
                    mem_wb_res = mem_out;
                } else {
                    mem_wb_res = ex_mem_res;
                }
            }
        }

        reflex do_memory {
            on fetch_active {
                // ram_addr is now u14 in ram module
                ram_addr = (id_ex_pc & 16383);
                
                // Advance MEM/WB structural metadata
                mem_wb_rd = ex_mem_rd;
                // Only write back if it's not a NOP (255) and not a STORE_OUT (1)
                mem_wb_we = (ex_mem_op != 255) && (ex_mem_op != 1); 
            }
        }

        ram::ram(${clk}, ram_addr, ex_mem_res, mem_out);

        // --- 5. Write-Back Stage (WB) ---
        // mem_wb_rd, mem_wb_we, and mem_wb_res are hooked directly to reg::regfile.
        reflex pack_output {
            on always {
                ${data_out} = mem_wb_res;
            }
        }
    }
}

module pipeline {}
