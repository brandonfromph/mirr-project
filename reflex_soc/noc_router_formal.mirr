        p60_rx_valid, p60_rx_data,
        p61_rx_valid, p61_rx_data,
        p62_rx_valid, p62_rx_data,
        p63_rx_valid, p63_rx_data
    );

    // In noc_router.mirr, data injected at port i goes into ring_data[i].
    // Every cycle, it shifts up by 1: ring_data[i+1] = ring_data[i].
    // p0_rx_data constantly reads ring_data[0].
    
    // If we inject data at port 0, it takes 1 cycle to appear in ring_data[0].
    // Then it should be visible at p0_rx_data on the next cycle.
    
    signal p0_tx_data_d1: internal u64;
    signal p0_tx_valid_d1: internal bool;

    reflex delay_tx {
        on always {
            p0_tx_data_d1 = p0_tx_data;
            p0_tx_valid_d1 = p0_tx_valid;
        }
    }

    // A simple property to ensure data injection latency
    // The noc_router is a ring buffer. Injecting at port 0 goes into ring_data[0].
    // Then p0_rx_data reads ring_data[0] always.
    // So p0_rx_data should equal p0_tx_data_d1.
    property port0_passthrough {
        always (p0_tx_valid_d1 -> (p0_rx_data == p0_tx_data_d1));
    }
}
