import "core/core_top.mirr" as core;

module core_top_formal {
    signal clk: in bool;
    signal rst_n: in bool;

    signal io_in_0: internal u64;
    signal io_out_0: out u64;

    signal pc_out: out u32;
    signal data_out: out u64;

    signal noc_rx_valid: internal bool;
    signal noc_rx_data: internal u64;
    signal noc_tx_valid: out bool;
    signal noc_tx_data: out u64;

    core::core_top(
        clk, rst_n,
        io_in_0, io_out_0,
        pc_out, data_out,
        noc_rx_valid, noc_rx_data,
        noc_tx_valid, noc_tx_data
    );

    // Property 1: noc_tx_valid is only asserted when a trap occurs and the core is halted.
    // If noc_tx_valid is asserted, noc_tx_data must contain the exception code.
    property exception_tx_format {
        always (noc_tx_valid -> ((noc_tx_data >> 32) == 3221225486)); // (1<<31) | 14 = 2147483662 ... Wait. (1<<63) is the trap bit.
        // Actually, (1<<63) | (14<<32) is what we set it to. Let's just check the upper 32 bits.
        // (1<<31) | 14 in the upper 32 bits is 2147483662.
        always (noc_tx_valid -> ((noc_tx_data >> 32) == 2147483662));
    }
}
