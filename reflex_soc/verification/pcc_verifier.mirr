//! Phase 7f: Hardware Proof Verification Unit (PCC)
//!
//! Trusted gatekeeper for the R-SPU. Validates certificate bounds
//! and program hash before enabling execution.

def pcc_verifier(
    sys_clk: signal in bool,
    sys_rst_n: signal in bool,

    // Certificate metadata (latched from cert stream)
    cert_instr_count: signal in u16,
    cert_reg_count:   signal in u16,
    cert_guard_count: signal in u16,
    cert_hash_match:  signal in bool, // Result of external SHA256 comparator
    cert_valid_sig:   signal in bool, // Result of external signature check

    // Outputs
    code_valid:   signal out bool,
    verify_fault: signal out bool
) {
    reflect {
        // Capacity constants matching proofs/cert/Verifier.v
        signal MAX_INSTRUCTIONS: internal u16;
        signal MAX_REGISTERS: internal u16;
        signal MAX_GUARDS: internal u16;

        // Bounds checking
        signal is_invalid: internal bool;
        reflex update_verification {
            on always {
                is_invalid = !(${cert_instr_count} <= 1024) || !(${cert_reg_count} <= 256) || !(${cert_guard_count} <= 32) || !${cert_hash_match} || !${cert_valid_sig};
                ${code_valid} = !is_invalid;
                ${verify_fault} = is_invalid;
            }
        }
    }
}

module pcc_verifier {}
