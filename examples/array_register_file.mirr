// Bounded register file using array signal type.
module array_register_file {
    signal regs: internal u32[16];  // 16-entry register file
    signal read_addr: in u8;
    signal write_addr: in u8;
    signal write_data: in u32;
    signal write_en: in bool;
    signal read_data: out u32;

    guard read_cycle { when true; }
    reflex read on read_cycle {
        read_data = regs[read_addr];
    }

    guard write_cycle { when write_en; }
    reflex write on write_cycle {
        regs[write_addr] = write_data;
    }
}
