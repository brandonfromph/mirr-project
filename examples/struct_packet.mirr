// Network packet with structured header.
struct PacketHeader {
    version: u4;
    length: u12;
    checksum: u16;
}

module struct_packet {
    signal header: internal PacketHeader;
    signal payload: internal u8[64];
    signal valid: in bool;

    guard process { when valid; }
    reflex update_header on process {
        header = PacketHeader { version: 1, length: 64, checksum: 0xABCD };
    }
}