+#[test]
+fn selfhost_fixture_root_exists() {
+    let root = fixture_root();
+    assert!(root.exists(), "fixture root must exist: {}", root.display());
+    assert!(
+        root.ends_with(Path::new("tests").join("fixtures")),
+        "fixture root must resolve to tests/fixtures"
+    );
+}
+
+#[test]
+fn selfhost_neonatal_source_exists() {
+    let source = neonatal_source();
+    assert!(source.exists(), "neonatal source must exist: {}", source.display());
+    assert!(
+        source.ends_with(Path::new("examples").join("neonatal_respirator.mirr")),
+        "source path must resolve to examples/neonatal_respirator.mirr"
+    );
+}
+
+#[test]
+fn selfhost_result_records_source_path() {
+    let result = run_pipeline(&neonatal_source());
+    assert!(
+        result.source_path.ends_with(Path::new("examples").join("neonatal_respirator.mirr")),
+        "result source_path must point to neonatal example"
+    );
+}
+
+#[test]
+fn selfhost_neonatal_stage_messages_are_non_empty() {
+    let result = run_pipeline(&neonatal_source());
+    assert!(!result.stages.is_empty(), "pipeline must emit stage results");
+    for stage in &result.stages {
+        assert!(
+            !stage.message.trim().is_empty(),
+            "stage '{}' must include a non-empty message",
+            stage.name
+        );
+    }
+}
+
+#[test]
+fn selfhost_neonatal_stage_names_are_unique() {
+    let result = run_pipeline(&neonatal_source());
+    let mut unique = HashSet::new();
+    for stage in &result.stages {
+        assert!(unique.insert(stage.name.clone()), "duplicate stage name: {}", stage.name);
+    }
+}
+
+#[test]
+fn selfhost_summary_mentions_source_filename() {
+    let result = run_pipeline(&neonatal_source());
+    let summary = result.summary_line();
+    assert!(summary.contains("neonatal_respirator.mirr"));
+}
+
+#[test]
+fn selfhost_statistics_include_compilation_time_field() {
+    let result = run_pipeline(&neonatal_source());
+    let json_str = result.netlist_json.as_ref().expect("netlist_json must be present");
+    let val: serde_json::Value = serde_json::from_str(json_str).expect("valid emitted JSON");
+    let stats = &val["statistics"];
+    for key in [
+        "shift_registers_used",
+        "counters_used",
+        "logic_gates_used",
+        "max_delay_cycles",
+        "total_signals",
+    ] {
+        assert!(stats[key].is_number(), "statistics.{key} must be numeric");
+    }
+
+    // This field is optional across historical fixture revisions.
+    if stats.get("compilation_time_us").is_some() {
+        assert!(
+            stats["compilation_time_us"].is_number() || stats["compilation_time_us"].is_null(),
+            "statistics.compilation_time_us must be numeric or null when present"
+        );
+    }
+}
+
+#[test]
+fn selfhost_verilog_emission_populates_output() {
+    let runner = BootstrapRunner::new(BootstrapOpts {
+        run_mirr_stages: false,
+        fixture_root: Some(fixture_root()),
+        emit_netlist_json: false,
+        emit_netlist_verilog: true,
+        fail_fast: false,
+        run_lexer_driver: false,
+    });
+    let result = runner.run(neonatal_source());
+
+    assert!(result.ok, "verilog emission run must succeed");
+    let verilog = result
+        .netlist_verilog
+        .as_ref()
+        .expect("netlist_verilog must be populated when emit_netlist_verilog=true");
+    assert!(verilog.contains("module"), "verilog output must contain a module declaration");
+}
