import "core/alu.mirr" as alu;

module rspu_top {
    signal sys_clk: in bool;
    
    // Define 16 cores as a flattened array of signals for the bus
    signal addr_0: in u16;
    signal data_out_0: out u17;
    signal data_in_0: in u16;
    signal addr_1: in u16;
    signal data_out_1: out u17;
    signal data_in_1: in u16;
    signal addr_2: in u16;
    signal data_out_2: out u17;
    signal data_in_2: in u16;
    signal addr_3: in u16;
    signal data_out_3: out u17;
    signal data_in_3: in u16;
    signal addr_4: in u16;
    signal data_out_4: out u17;
    signal data_in_4: in u16;
    signal addr_5: in u16;
    signal data_out_5: out u17;
    signal data_in_5: in u16;
    signal addr_6: in u16;
    signal data_out_6: out u17;
    signal data_in_6: in u16;
    signal addr_7: in u16;
    signal data_out_7: out u17;
    signal data_in_7: in u16;
    signal addr_8: in u16;
    signal data_out_8: out u17;
    signal data_in_8: in u16;
    signal addr_9: in u16;
    signal data_out_9: out u17;
    signal data_in_9: in u16;
    signal addr_10: in u16;
    signal data_out_10: out u17;
    signal data_in_10: in u16;
    signal addr_11: in u16;
    signal data_out_11: out u17;
    signal data_in_11: in u16;
    signal addr_12: in u16;
    signal data_out_12: out u17;
    signal data_in_12: in u16;
    signal addr_13: in u16;
    signal data_out_13: out u17;
    signal data_in_13: in u16;
    signal addr_14: in u16;
    signal data_out_14: out u17;
    signal data_in_14: in u16;
    signal addr_15: in u16;
    signal data_out_15: out u17;
    signal data_in_15: in u16;

    // The shared instruction bus
    signal instr_bus: internal u16;

    // Stamp out the 16 cores
    alu::alu_core(sys_clk, instr_bus, addr_0, data_in_0, data_out_0);
    alu::alu_core(sys_clk, instr_bus, addr_1, data_in_1, data_out_1);
    alu::alu_core(sys_clk, instr_bus, addr_2, data_in_2, data_out_2);
    alu::alu_core(sys_clk, instr_bus, addr_3, data_in_3, data_out_3);
    alu::alu_core(sys_clk, instr_bus, addr_4, data_in_4, data_out_4);
    alu::alu_core(sys_clk, instr_bus, addr_5, data_in_5, data_out_5);
    alu::alu_core(sys_clk, instr_bus, addr_6, data_in_6, data_out_6);
    alu::alu_core(sys_clk, instr_bus, addr_7, data_in_7, data_out_7);
    alu::alu_core(sys_clk, instr_bus, addr_8, data_in_8, data_out_8);
    alu::alu_core(sys_clk, instr_bus, addr_9, data_in_9, data_out_9);
    alu::alu_core(sys_clk, instr_bus, addr_10, data_in_10, data_out_10);
    alu::alu_core(sys_clk, instr_bus, addr_11, data_in_11, data_out_11);
    alu::alu_core(sys_clk, instr_bus, addr_12, data_in_12, data_out_12);
    alu::alu_core(sys_clk, instr_bus, addr_13, data_in_13, data_out_13);
    alu::alu_core(sys_clk, instr_bus, addr_14, data_in_14, data_out_14);
    alu::alu_core(sys_clk, instr_bus, addr_15, data_in_15, data_out_15);


    property all_cores_active {
        always (sys_clk -> (addr_0 > 0));
    }
}
