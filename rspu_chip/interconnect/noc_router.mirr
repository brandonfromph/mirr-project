//! Phase 8b: 16-Core Network-on-Chip (NoC) Router
//!
//! Packet-switched 64-bit interconnect for the R-SPU fabric.
//! Uses a simplified Star topology for initial integration.

def noc_router(
    clk: signal in bool,
    rst_n: signal in bool,

    // TX Signals
    port_tx_valid_0: signal in bool, port_tx_data_0: signal in u64,
    port_tx_valid_1: signal in bool, port_tx_data_1: signal in u64,
    port_tx_valid_2: signal in bool, port_tx_data_2: signal in u64,
    port_tx_valid_3: signal in bool, port_tx_data_3: signal in u64,
    port_tx_valid_4: signal in bool, port_tx_data_4: signal in u64,
    port_tx_valid_5: signal in bool, port_tx_data_5: signal in u64,
    port_tx_valid_6: signal in bool, port_tx_data_6: signal in u64,
    port_tx_valid_7: signal in bool, port_tx_data_7: signal in u64,
    port_tx_valid_8: signal in bool, port_tx_data_8: signal in u64,
    port_tx_valid_9: signal in bool, port_tx_data_9: signal in u64,
    port_tx_valid_10: signal in bool, port_tx_data_10: signal in u64,
    port_tx_valid_11: signal in bool, port_tx_data_11: signal in u64,
    port_tx_valid_12: signal in bool, port_tx_data_12: signal in u64,
    port_tx_valid_13: signal in bool, port_tx_data_13: signal in u64,
    port_tx_valid_14: signal in bool, port_tx_data_14: signal in u64,
    port_tx_valid_15: signal in bool, port_tx_data_15: signal in u64,

    // RX Signals
    port_rx_valid_0: signal out bool, port_rx_data_0: signal out u64,
    port_rx_valid_1: signal out bool, port_rx_data_1: signal out u64,
    port_rx_valid_2: signal out bool, port_rx_data_2: signal out u64,
    port_rx_valid_3: signal out bool, port_rx_data_3: signal out u64,
    port_rx_valid_4: signal out bool, port_rx_data_4: signal out u64,
    port_rx_valid_5: signal out bool, port_rx_data_5: signal out u64,
    port_rx_valid_6: signal out bool, port_rx_data_6: signal out u64,
    port_rx_valid_7: signal out bool, port_rx_data_7: signal out u64,
    port_rx_valid_8: signal out bool, port_rx_data_8: signal out u64,
    port_rx_valid_9: signal out bool, port_rx_data_9: signal out u64,
    port_rx_valid_10: signal out bool, port_rx_data_10: signal out u64,
    port_rx_valid_11: signal out bool, port_rx_data_11: signal out u64,
    port_rx_valid_12: signal out bool, port_rx_data_12: signal out u64,
    port_rx_valid_13: signal out bool, port_rx_data_13: signal out u64,
    port_rx_valid_14: signal out bool, port_rx_data_14: signal out u64,
    port_rx_valid_15: signal out bool, port_rx_data_15: signal out u64
) {
    reflect {
        // Star Topology Dispatch with Reflexive Priority Routing
        reflex simple_switch {
            let rx_has_priority_0: bool = false;
            let rx_has_priority_1: bool = false;
            let rx_has_priority_2: bool = false;
            let rx_has_priority_3: bool = false;
            let rx_has_priority_4: bool = false;
            let rx_has_priority_5: bool = false;
            let rx_has_priority_6: bool = false;
            let rx_has_priority_7: bool = false;
            let rx_has_priority_8: bool = false;
            let rx_has_priority_9: bool = false;
            let rx_has_priority_10: bool = false;
            let rx_has_priority_11: bool = false;
            let rx_has_priority_12: bool = false;
            let rx_has_priority_13: bool = false;
            let rx_has_priority_14: bool = false;
            let rx_has_priority_15: bool = false;

            // Default: Idle all outputs
            ${port_rx_valid_0} = false;
            ${port_rx_data_0}  = 0;
            ${port_rx_valid_1} = false;
            ${port_rx_data_1}  = 0;
            ${port_rx_valid_2} = false;
            ${port_rx_data_2}  = 0;
            ${port_rx_valid_3} = false;
            ${port_rx_data_3}  = 0;
            ${port_rx_valid_4} = false;
            ${port_rx_data_4}  = 0;
            ${port_rx_valid_5} = false;
            ${port_rx_data_5}  = 0;
            ${port_rx_valid_6} = false;
            ${port_rx_data_6}  = 0;
            ${port_rx_valid_7} = false;
            ${port_rx_data_7}  = 0;
            ${port_rx_valid_8} = false;
            ${port_rx_data_8}  = 0;
            ${port_rx_valid_9} = false;
            ${port_rx_data_9}  = 0;
            ${port_rx_valid_10} = false;
            ${port_rx_data_10}  = 0;
            ${port_rx_valid_11} = false;
            ${port_rx_data_11}  = 0;
            ${port_rx_valid_12} = false;
            ${port_rx_data_12}  = 0;
            ${port_rx_valid_13} = false;
            ${port_rx_data_13}  = 0;
            ${port_rx_valid_14} = false;
            ${port_rx_data_14}  = 0;
            ${port_rx_valid_15} = false;
            ${port_rx_data_15}  = 0;

            // Route Logic
            on ${port_tx_valid_0} {
                let dest_id: u64 = (${port_tx_data_0} >> 60) && 15;
                let payload: u64 = ${port_tx_data_0};
                let priority: u64 = (payload >> 59) && 1;
                let is_reflexive: bool = (priority == 1) || (0 == 14) || (0 == 15) || (dest_id == 14) || (dest_id == 15);

                match dest_id {
                    0  => {
                        if is_reflexive || !rx_has_priority_0 {
                            ${port_rx_valid_0} = true;
                            ${port_rx_data_0}  = payload;
                            if is_reflexive {
                                rx_has_priority_0 = true;
                            }
                        }
                    }
                    1  => {
                        if is_reflexive || !rx_has_priority_1 {
                            ${port_rx_valid_1} = true;
                            ${port_rx_data_1}  = payload;
                            if is_reflexive {
                                rx_has_priority_1 = true;
                            }
                        }
                    }
                    2  => {
                        if is_reflexive || !rx_has_priority_2 {
                            ${port_rx_valid_2} = true;
                            ${port_rx_data_2}  = payload;
                            if is_reflexive {
                                rx_has_priority_2 = true;
                            }
                        }
                    }
                    3  => {
                        if is_reflexive || !rx_has_priority_3 {
                            ${port_rx_valid_3} = true;
                            ${port_rx_data_3}  = payload;
                            if is_reflexive {
                                rx_has_priority_3 = true;
                            }
                        }
                    }
                    4  => {
                        if is_reflexive || !rx_has_priority_4 {
                            ${port_rx_valid_4} = true;
                            ${port_rx_data_4}  = payload;
                            if is_reflexive {
                                rx_has_priority_4 = true;
                            }
                        }
                    }
                    5  => {
                        if is_reflexive || !rx_has_priority_5 {
                            ${port_rx_valid_5} = true;
                            ${port_rx_data_5}  = payload;
                            if is_reflexive {
                                rx_has_priority_5 = true;
                            }
                        }
                    }
                    6  => {
                        if is_reflexive || !rx_has_priority_6 {
                            ${port_rx_valid_6} = true;
                            ${port_rx_data_6}  = payload;
                            if is_reflexive {
                                rx_has_priority_6 = true;
                            }
                        }
                    }
                    7  => {
                        if is_reflexive || !rx_has_priority_7 {
                            ${port_rx_valid_7} = true;
                            ${port_rx_data_7}  = payload;
                            if is_reflexive {
                                rx_has_priority_7 = true;
                            }
                        }
                    }
                    8  => {
                        if is_reflexive || !rx_has_priority_8 {
                            ${port_rx_valid_8} = true;
                            ${port_rx_data_8}  = payload;
                            if is_reflexive {
                                rx_has_priority_8 = true;
                            }
                        }
                    }
                    9  => {
                        if is_reflexive || !rx_has_priority_9 {
                            ${port_rx_valid_9} = true;
                            ${port_rx_data_9}  = payload;
                            if is_reflexive {
                                rx_has_priority_9 = true;
                            }
                        }
                    }
                    10  => {
                        if is_reflexive || !rx_has_priority_10 {
                            ${port_rx_valid_10} = true;
                            ${port_rx_data_10}  = payload;
                            if is_reflexive {
                                rx_has_priority_10 = true;
                            }
                        }
                    }
                    11  => {
                        if is_reflexive || !rx_has_priority_11 {
                            ${port_rx_valid_11} = true;
                            ${port_rx_data_11}  = payload;
                            if is_reflexive {
                                rx_has_priority_11 = true;
                            }
                        }
                    }
                    12  => {
                        if is_reflexive || !rx_has_priority_12 {
                            ${port_rx_valid_12} = true;
                            ${port_rx_data_12}  = payload;
                            if is_reflexive {
                                rx_has_priority_12 = true;
                            }
                        }
                    }
                    13  => {
                        if is_reflexive || !rx_has_priority_13 {
                            ${port_rx_valid_13} = true;
                            ${port_rx_data_13}  = payload;
                            if is_reflexive {
                                rx_has_priority_13 = true;
                            }
                        }
                    }
                    14  => {
                        if is_reflexive || !rx_has_priority_14 {
                            ${port_rx_valid_14} = true;
                            ${port_rx_data_14}  = payload;
                            if is_reflexive {
