def mem_block_7(clk: signal in bool, addr: signal in u16, data: signal out u16) {
    reflect {
        signal valid: internal bool;
        guard mem_ready {
            when ${clk} && ${addr} > 0
            for 1 cycles;
        }
        reflex set_data {
            on mem_ready {
                ${data} = ${addr} + 7;
                valid = true;
            }
        }
    }
}
def mem_bulk_7_0(x: signal in bool, y: signal out bool) {
    reflect { reflex pass { on ${x} { ${y} = true; } } }
}
