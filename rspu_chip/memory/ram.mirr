// RAM pattern — generic memory block
def ram(
    clk: signal in bool,
    addr: signal in u16,
    data_in: signal in u16,
    data_out: signal out u17
) {
    reflect {
        guard mem_ready {
            when ${clk} && ${addr} > 0
            for 1 cycles;
        }

        reflex store {
            on mem_ready {
                ${data_out} = ${data_in};
            }
        }
    }
}

module ram_stub {}
