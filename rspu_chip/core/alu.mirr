// RSPU Core: Instruction Decoder & ALU
import "ram.mirr" as ram;
import "isa_map.mirr" as isa;

def alu_core(
    clk: signal in bool,
    instr: signal in u16,
    addr: signal in u16,
    data_in: signal in u16,
    data_out: signal out u17
) {
    reflect {
        // Core Memory
        ram::ram(${clk}, ${addr}, ${data_in}, ${data_out});

        // Core State
        signal result: internal u17;

        // --- Decoder System (Traffic Controller) ---
        guard dispatch {
            when ${clk}
            for 1 cycles;
        }

        // --- Formal Verification Invariants ---
        property no_alu_overflow {
            always (result < 131072);
        }

        // --- Upgraded Dispatcher reflex using Rust-like let and match syntax ---
        reflex alu_execution {
            on dispatch {
                match instr {
                    isa::ADD => {
                        let add_res: u17 = data_in + addr;
                        result = add_res;
                        data_out = result;
                    }
                    isa::SUB => {
                        let sub_res: u17 = data_in - addr;
                        result = sub_res;
                        data_out = result;
                    }
                    _ => {
                        let mov_res: u17 = data_in;
                        result = mov_res;
                        data_out = result;
                    }
                }
            }
        }
    }
}

module alu {}
