// RSPU Core: Instruction Decoder & ALU
import "../memory/ram.mirr" as ram;

def alu_core(
    clk: signal in bool,
    instr: signal in u16, 
    addr: signal in u16,
    data_in: signal in u16,
    data_out: signal out u17
) {
    reflect {
        // Core Memory
        ram::ram(${clk}, ${addr}, ${data_in}, ${data_out});

        // Core State
        signal result: internal u17;

        // --- Decoder System (Traffic Controller) ---
        // Opcode Mapping:
        // 0: ADD, 1: SUB, 2: MOV (Placeholder)
        guard is_add { 
            when ${clk} && ${instr} == 0 
            for 1 cycles;
        }
        
        guard is_sub { 
            when ${clk} && ${instr} == 1 
            for 1 cycles;
        }
        
        guard is_mov { 
            when ${clk} && ${instr} == 2 
            for 1 cycles;
        }

        reflex execute_add {
            on is_add {
                result = data_in + addr;
                data_out = result;
            }
        }

        reflex execute_sub {
            on is_sub {
                result = data_in - addr;
                data_out = result;
            }
        }

        reflex execute_mov {
            on is_mov {
                result = data_in;
                data_out = result;
            }
        }
    }
}

module alu {}

