import "memory/mem_15.mirr" as mem;

def alu_core_15(clk: signal in bool, op1: signal in u16, op2: signal out u16) {
    reflect {
        mem_block_15(${clk}, ${op1}, ${op2});
        guard alu_active {
            when ${clk}
            for 1 cycles;
        }
        signal stage_0: internal bool;
        signal stage_1: internal bool;
        signal stage_2: internal bool;
        signal stage_3: internal bool;
        signal stage_4: internal bool;
        signal stage_5: internal bool;
        signal stage_6: internal bool;
        signal stage_7: internal bool;
        signal stage_8: internal bool;
        signal stage_9: internal bool;
        signal stage_10: internal bool;
        signal stage_11: internal bool;
        signal stage_12: internal bool;
        signal stage_13: internal bool;
        signal stage_14: internal bool;
        signal stage_15: internal bool;
    }
}
def alu_bulk_15_0(x: signal in bool, y: signal out bool) {
    reflect { reflex pass { on ${x} { ${y} = true; } } }
}
def alu_bulk_15_1(x: signal in bool, y: signal out bool) {
    reflect { reflex pass { on ${x} { ${y} = true; } } }
