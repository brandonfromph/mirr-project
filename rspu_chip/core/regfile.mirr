//! Phase 8a: R-SPU Register File
//!
//! Implements 256 tagged-word registers (64-bit each).
//! Supports two read ports and one write port.

def regfile(
    clk: signal in bool,
    rs1: signal in u8,
    rs2: signal in u8,
    rd:  signal in u8,
    we:  signal in bool,
    din: signal in u64,
    dout1: signal out u64,
    dout2: signal out u64
) {
    reflect {
        // Register array: [element; length]
        // MIRR supports large arrays in archetypes.
        signal regs: internal u64[256];

        // --- Read Ports (Combinational) ---
        reflex read_ports {
            on always {
                ${dout1} = regs[${rs1}];
                ${dout2} = regs[${rs2}];
            }
        }

        // --- Write Port (Synchronous) ---
        guard write_enable {
            when ${clk} && ${we}
            for 1 cycles;
        }

        reflex write_port {
            on write_enable {
                regs[${rd}] = ${din};
            }
        }
    }
}

module regfile {}
