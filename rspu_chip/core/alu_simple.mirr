module alu_simple {
    def alu_add(
        clk: signal in bool,
        a: signal in u16,
        b: signal in u16,
        result: signal out u32
    ) {
        reflect {
            guard is_enabled {
                when ${clk}
                for 1 cycles;
            }
            
            reflex do_add {
                on is_enabled {
                    ${result} = (${a} + ${b});
                }
            }
        }
    }
}
