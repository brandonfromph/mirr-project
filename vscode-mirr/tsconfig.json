{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "outDir": "out",
        "lib": ["es2020"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "include": ["src"]
}
