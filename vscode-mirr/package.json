{
  "name": "mirr-lang",
  "displayName": "MIRR Language Support",
  "description": "Syntax highlighting, icon, and theme for MIRR (no LSP or compiler service in this package).",
  "version": "0.2.0",
  "publisher": "mirr-project",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/brandonfromph/mirr-project",
    "directory": "vscode-mirr"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "scripts": {
    "rwfi2:compat": "node -e \"const fs=require('fs');const p='./package.json';const d=JSON.parse(fs.readFileSync(p,'utf8'));if(!d.contributes||!Array.isArray(d.contributes.languages)){throw new Error('missing contributes.languages');}if(!d.contributes.languages.some(l=>l.id==='mirr')){throw new Error('missing mirr language contribution');}\"",
    "test": "npm run rwfi2:compat"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "contributes": {
    "languages": [
      {
        "id": "mirr",
        "aliases": ["MIRR", "mirr"],
        "extensions": [".mirr"],
        "icon": {
          "light": "./icons/mirr-file.svg",
          "dark": "./icons/mirr-file.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "mirr",
        "scopeName": "source.mirr",
        "path": "./syntaxes/mirr.tmLanguage.json"
      }
    ],
    "themes": [
      {
        "label": "MIRR Ouroboros Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/mirr-ouroboros-dark.json"
      }
    ],
    "iconThemes": [
      {
        "id": "mirr-icons",
        "label": "MIRR File Icons",
        "path": "./icons/mirr-icon-theme.json"
      }
    ]
  }
}
