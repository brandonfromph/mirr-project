{
  "comments": {
    "lineComment": "//"
  },
  "wordPattern": "[a-zA-Z_][a-zA-Z0-9_]*",
  "indentationRules": {
    "increaseIndentPattern": "^.*\\{\\s*$",
    "decreaseIndentPattern": "^\\s*\\}"
  },
  "brackets": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"]
  ],
  "autoClosingPairs": [
    { "open": "{", "close": "}" },
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["{", "}"],
    ["(", ")"],
    ["[", "]"],
    ["\"", "\""]
  ],
  "folding": {
    "markers": {
      "start": "\\{",
      "end": "\\}"
    }
  },
  "onEnterRules": [
    {
      "beforeText": "^.*\\{\\s*$",
      "afterText": "^\\s*\\}",
      "action": { "indent": "indentOutdent", "appendText": "    " }
    },
    {
      "beforeText": "^.*\\{\\s*$",
      "action": { "indent": "indent", "appendText": "    " }
    }
  ]
}
