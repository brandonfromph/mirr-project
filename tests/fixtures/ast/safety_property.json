{
  "ir_version": "2.0",
  "module": {
    "name": "pressure_monitor",
    "signals": [
      {
        "name": "airway_pressure",
        "kind": "Input",
        "ty": {
          "core": {
            "Unsigned": 16
          }
        }
      },
      {
        "name": "clamp_valve",
        "kind": "Output",
        "ty": {
          "core": "Bool"
        }
      }
    ],
    "guards": [
      {
