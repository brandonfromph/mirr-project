            }
          }
        }
      },
      {
        "name": "quality_bounded",
        "directive": "Assert",
        "formula": {
          "Always": {
            "Binary": {
              "op": "Le",
              "left": {
                "Signal": "link_quality"
              },
              "right": {
                "Literal": {
                  "Integer": 100
                }
              }
            }
          }
        }
      }
    ],
    "pattern_calls": [],
    "pattern_origins": []
