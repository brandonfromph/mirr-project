module mux_forest {
    signal in_sig: in bool;
    signal out_sig: out bool;
    signal s0: bool;
    signal s1: bool;
    signal s2: bool;
    signal s3: bool;
    signal s4: bool;

    reflex r {
        on true {
            if s0 {
            if s1 {
            if s2 {
            if s3 {
            if s4 {
                out_sig = in_sig;
            }
            }
            }
            }
            }
        }
    }
}

