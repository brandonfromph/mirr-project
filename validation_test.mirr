// MEGA-10 validation test - checking if the claimed syntax actually works

struct Point {
    x: u16;
    y: u16;
}

struct Packet {
    header: u8;
    data: u32;
    checksum: u8;
}

interface SPI {
    clk: out bool;
    mosi: out bool;
    miso: in bool;
    cs: out bool;
}

module ValidationTest {
    // Array signals
    signal memory: internal u8[16];
    signal matrix: internal u16[4][4];

    // Struct signals
    signal pos: internal struct Point;
    signal pkt: internal struct Packet;

    // Fixed-point signals
    signal sensor: internal fixed<16,8>;
    signal coeff: internal fixed<32,16>;

    // Interface bundles
    signal spi_bus: internal interface SPI;

    // Regular signals for testing
    signal index: internal u4;
    signal enable: internal bool;

    // Guards with composite expressions
    guard array_access when enable {
        memory[index] = 42;
        matrix[0][1] = 100;
    }

    guard struct_access when enable {
        pos.x = 10;
        pos.y = 20;
        pkt.header = 0xFF;
    }

    guard literals when enable {
        memory[0] = [0, 1, 2, 3][index];
        pos = Point { x: 100, y: 200 };
    }
}