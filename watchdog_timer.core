CAPI=2:
name: brandonfromph:mirr:watchdog:1.0.0
description: A verified, temporally-safe hardware watchdog timer generated by MIRR.

generate:
  watchdog_logic:
    generator: mirr_gen
    parameters:
      file: examples/watchdog_timer.mirr

targets:
  default: &default
    filesets: [src]
    generate: [watchdog_logic]

  sim:
    <<: *default
    description: Simulate the watchdog timer
    default_tool: icarus
    toplevel: watchdog_timer
